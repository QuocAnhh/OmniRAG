# ─── OmniRAG environment ──────────────────────────────────────────────────────
#
#   cp .env.example .env
#
# Docker Compose auto-loads .env from this directory and nothing else, so every
# value below belongs here — not in .env.prod, which no file reads.
#
# Generate every secret as hex:
#
#   openssl rand -hex 32
#
# Hex specifically. The Postgres/Mongo/Redis connection strings are built by raw
# string interpolation with no percent-encoding, so a password containing
# @ : / ? # % produces a wrong connection string rather than an error.
#
# Variables written as ${VAR:?} in docker-compose.yml are required — the deploy
# stops with a clear message if one is missing, instead of falling back to a
# weak default.

# ── Required secrets ──────────────────────────────────────────────────────────
# JWT signing key for the backend. Changing it logs every user out.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Gateway's own secret. Must be set before ENVIRONMENT=production or the
# gateway refuses to boot.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
MONGO_PASSWORD=CHANGE_ME_openssl_rand_hex_32
MINIO_ROOT_USER=omniragadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_32

OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# ── Deployment ────────────────────────────────────────────────────────────────
# production | development. Defaults to production when unset.
ENVIRONMENT=production
# Public origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173
# Public URL of this backend, used when registering channel webhooks.
PUBLIC_URL=

# ── Optional overrides ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=omnirag
MONGO_USER=admin
OPENROUTER_CHAT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=OmniRAG
RATE_LIMIT_RPS=100

# ── Channels (optional) ───────────────────────────────────────────────────────
# Leave blank to disable. Every channel webhook fails closed, so a blank secret
# rejects all inbound requests rather than accepting them unauthenticated.
ZALO_HUB_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FB_WORKER_API_TOKEN=
FB_INBOUND_SECRET=
ZALO_PERSONAL_ENABLED=false
ZALO_PERSONAL_WORKER_API_TOKEN=
ZALO_PERSONAL_INBOUND_SECRET=
VITE_ENABLE_ZALO_PERSONAL=false

# ── Local development only ────────────────────────────────────────────────────
# Host ports used by docker-compose.dev.yml. Ignored by the base stack, which
# publishes nothing but the gateway and the frontend.
GATEWAY_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8001
POSTGRES_HOST_PORT=5433
MONGODB_HOST_PORT=27017
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
QDRANT_HOST_PORT=6333
PDF_HYBRID_HOST_PORT=5002
