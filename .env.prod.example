# ============================================================
# Copy file này thành .env.prod và điền giá trị thật
# Trên server: cp .env.prod.example .env.prod
# ============================================================

# ---- Frontend URLs (domain của bạn) ----
VITE_API_URL=https://your-domain.com
VITE_WS_URL=wss://your-domain.com

# ---- PostgreSQL ----
POSTGRES_USER=omnirag
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=omnirag

# ---- MongoDB ----
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_strong_password

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_strong_password

# ---- MinIO ----
MINIO_ROOT_USER=CHANGE_ME_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password

# ============================================================
# Các biến dưới đây copy từ backend/.env rồi điền vào đây
# ============================================================

# ---- Security ----
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ENVIRONMENT=production

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_ENABLE_FALLBACKS=true
OPENROUTER_SITE_URL=https://your-domain.com
OPENROUTER_SITE_NAME=OmniRAG

# ---- Database URLs (phải khớp với credentials ở trên) ----
DATABASE_URL=postgresql://omnirag:CHANGE_ME_strong_password@db:5432/omnirag
MONGODB_URL=mongodb://admin:CHANGE_ME_strong_password@mongodb:27017
REDIS_URL=redis://:CHANGE_ME_strong_password@redis:6379/0

# ---- Other services ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_admin_user
MINIO_SECRET_KEY=CHANGE_ME_strong_password

# ---- Public URL ----
PUBLIC_URL=https://your-domain.com

# ---- Mem0 ----
MEM0_ENABLED=true
MEM0_COLLECTION_NAME=omnirag_memories
MEM0_MEMORY_MODEL=openai/gpt-4o-mini
MEM0_TOP_K=5

# ---- Zalo (optional) ----
ZALO_HUB_WEBHOOK_SECRET=CHANGE_ME
FUNC_API_URL=
FUNC_API_TOKEN=

# ---- Facebook Messenger channel (optional, GPL v3 isolated microservice) ----
# Both tokens must be strong, ≥32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FB_WORKER_URL=http://fb-channel-worker:9100
FB_WORKER_API_TOKEN=CHANGE_ME_strong_random
FB_INBOUND_SECRET=CHANGE_ME_strong_random

# ---- Zalo Personal Account channel (experimental, unofficial zca-js) ----
# Disabled by default. Use a dedicated Zalo account.
ZALO_PERSONAL_ENABLED=false
ZALO_PERSONAL_WORKER_URL=http://zalo-personal-worker:9200
ZALO_PERSONAL_WORKER_API_TOKEN=CHANGE_ME_strong_random
ZALO_PERSONAL_INBOUND_SECRET=CHANGE_ME_strong_random
VITE_ENABLE_ZALO_PERSONAL=false
